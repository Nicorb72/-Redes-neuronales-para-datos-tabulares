# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments and local configuration
.venv/
venv/
.env
.env.*
!.env.example

# Original source data is downloaded locally and is not committed by default.
/data/raw/*
!/data/raw/README.md
!/data/raw/.gitkeep

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db


# Archivos generados del procesamiento
/data/processed/*
!/data/processed/README.md
!/data/processed/X_train_pd.npz
!/data/processed/y_train_pd.npy
!/data/processed/X_validation_pd.npz
!/data/processed/y_validation_pd.npy
!/data/processed/X_test_pd.npz
!/data/processed/y_test_pd.npy

# Modelos y transformadores generados
/artifacts/models/*
!/artifacts/models/README.md
!/artifacts/models/pd_mlp_hyperparameter_search.pt
!/artifacts/models/pd_mlp_hyperparameter_search_preprocessor.joblib
!/artifacts/models/pd_mlp_final.pt
!/artifacts/models/pd_logistic.joblib
!/artifacts/models/pd_preprocessor.joblib
!/artifacts/models/pd_feature_names.json
!/artifacts/models/pd_bundle.json

# Archivos temporales
/artifacts/prueba_data/

# Figuras generadas
/reports/figures/*
!/reports/figures/README.md
!/reports/figures/*.svg

# Notebooks de experimentos reproducibles: permitir su publicación en GitHub.
!/src/notebooks/
!/src/notebooks/**/*.ipynb
